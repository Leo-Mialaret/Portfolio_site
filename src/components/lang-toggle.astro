---
// Language toggle component - client-side only
---
<button 
	data-lang-toggle 
	type="button"
	class="lang-toggle"
	aria-label="Switch language"
	onclick="toggleLang()"
>
	EN
</button>

<style>
	.lang-toggle {
		background: transparent;
		border: 1px solid currentColor;
		border-radius: 4px;
		padding: 0.25rem 0.5rem;
		cursor: pointer;
		font-size: 0.875rem;
		font-weight: 600;
		transition: all 0.2s ease;
	}
	
	.lang-toggle:hover {
		background: rgba(128, 128, 128, 0.1);
	}
	
	.lang-toggle:focus {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
</style>
