---
import t from './t.astro';
import projectsData from '../data/projects.json';
---

<section id="projects" class="projects">
	<div class="container">
		<t key="projects.title" tag="h2" class="section-title" />
		<t key="projects.subtitle" tag="p" class="section-subtitle" />
		
		<div class="projects-grid">
			<!-- Project cards would go here -->
		</div>
	</div>
</section>

<style>
	.projects {
		padding: 6rem 2rem;
	}
	
	.container {
		max-width: 1200px;
		margin: 0 auto;
	}
	
	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		text-align: center;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}
	
	.section-subtitle {
		text-align: center;
		color: var(--text-secondary);
		font-size: 1.125rem;
		max-width: 600px;
		margin: 0 auto 3rem;
	}
	
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2rem;
	}
</style>
