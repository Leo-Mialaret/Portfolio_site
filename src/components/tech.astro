---
import t from './t.astro';
import techData from '../data/tech.json';
---

<section id="tech" class="tech">
	<div class="container">
		<t key="tech.title" tag="h2" class="section-title" />
		<t key="tech.subtitle" tag="p" class="section-subtitle" />
		
		<div class="tech-content">
			<!-- Tech categories would go here -->
		</div>
	</div>
</section>

<style>
	.tech {
		padding: 6rem 2rem;
		background: var(--bg-secondary);
	}
	
	.container {
		max-width: 1200px;
		margin: 0 auto;
	}
	
	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		text-align: center;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}
	
	.section-subtitle {
		text-align: center;
		color: var(--text-secondary);
		font-size: 1.125rem;
		max-width: 600px;
		margin: 0 auto 3rem;
	}
</style>
