---
import { Icon } from 'astro-icon/components';
import localTechData from '../data/tech.json';

interface Skill {
  name: string;
  name_en?: string;
  level: number;
  icon: string;
}

interface Category {
  title: string;
  title_en?: string;
  skills: Skill[];
}

const BASEURL = import.meta.env.PUBLIC_API_BASEURL;

let categories: Category[];

try {
  if (BASEURL) {
    const response = await fetch(`${BASEURL}/tech`);
    const data = await response.json();
    categories = data.categories;
  } else {
    categories = localTechData.categories;
  }
} catch {
  categories = localTechData.categories;
}
---

<section id="tech" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="tech-header flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span>
          <span class="i18n-fr">Compétences</span>
          <span class="i18n-en">Skills</span>
        </h2>
        <p class="text-subtext font-body text-sm max-w-md">
          <span class="i18n-fr">Un aperçu de mes compétences, organisées par domaine.</span>
          <span class="i18n-en">An overview of my skills, organised by area.</span>
        </p>
      </div>

      <div class="flex flex-wrap gap-4 p-3 rounded-xl bg-accent/5 border border-accent/10 backdrop-blur-sm">
        {[
          { labelFr: "Utilisation autonome", labelEn: "Independent use", level: 3 },
          { labelFr: "Connaissances pratiques", labelEn: "Practical knowledge", level: 2 },
          { labelFr: "Connaissances de base", labelEn: "Basic knowledge", level: 1 }
        ].map((item, index) => (
          <div class={`flex items-center gap-2 ${index > 0 ? 'md:border-l md:border-white/10 md:pl-4' : ''}`}>
            <div class="flex gap-0.5">
              {[1, 2, 3].map((star) => (
                <Icon
                  name="mdi:star"
                  class={`w-3 h-3 ${star <= item.level ? 'text-accent drop-shadow-[0_0_3px_var(--color-accent)]' : 'text-gray-600'}`}
                />
              ))}
            </div>
            <span class="text-[10px] uppercase tracking-wider text-subtext">
              <span class="i18n-fr">{item.labelFr}</span>
              <span class="i18n-en">{item.labelEn}</span>
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-10">
      {categories.map((category) => (
        <div class="space-y-3">
          <h3 class="text-maintext font-body text-[11px] uppercase tracking-[0.4em] ml-1">
            <span class="i18n-fr">{category.title}</span>
            <span class="i18n-en">{category.title_en || category.title}</span>
          </h3>

          <div class="grid grid-cols-[repeat(auto-fill,minmax(13rem,1fr))] gap-5 sm:gap-8">
            {category.skills.map((skill) => (
              <div class="skill-card opacity-0 group relative flex items-stretch min-h-14 rounded-xl bg-accent/5 border border-accent/15 hover:border-accent/40 hover:bg-accent/10 transition-all duration-300">
                <div class="shrink-0 w-12 flex items-center justify-center rounded-l-xl bg-accent/15 transition-colors group-hover:bg-accent/20">
                  <Icon name={skill.icon} class="w-7 h-7 group-hover:scale-110 transition-transform" />
                </div>

                <div class="flex min-w-0 items-center px-3 py-2 w-full">
                  <span class="min-w-0 font-body text-maintext/90 text-[13px] leading-tight font-medium tracking-tight line-clamp-2">
                    <span class="i18n-fr">{skill.name}</span>
                    <span class="i18n-en">{skill.name_en || skill.name}</span>
                  </span>
                </div>

                <div class="absolute -bottom-2 -right-1 z-10 flex gap-0 px-1 py-0.5 bg-container rounded-md border border-white/10 shadow-lg group-hover:border-accent/30 transition-all">
                  {[1, 2, 3].map((star) => (
                    <Icon
                      name="mdi:star"
                      class={`w-3 h-3 transition-colors duration-500 ${star <= skill.level ? 'text-accent drop-shadow-[0_0_3px_var(--color-accent)]' : 'text-gray-600'}`}
                    />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-header {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .skill-card {
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tech-header.reveal,
  .skill-card.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealSkills() {
    const header = document.querySelector('.tech-header');
    const cards = document.querySelectorAll('.skill-card');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;

          if (target.classList.contains('tech-header')) {
            target.classList.add('reveal');
            observer.unobserve(target);
          } else if (target.classList.contains('skill-card')) {
            const index = Array.from(cards).indexOf(target);
            setTimeout(() => {
              target.classList.add('reveal');
            }, (index % 6) * 50);
            observer.unobserve(target);
          }
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    if (header) observer.observe(header);
    cards.forEach((card) => observer.observe(card));
  }

  revealSkills();
  document.addEventListener('astro:after-swap', revealSkills);
</script>