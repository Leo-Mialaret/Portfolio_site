---
// Client-side translation component
// Usage: <t key="home.title" /> or <t key="home.title" tag="h1" class="title" />
interface Props {
	key: string;
	tag?: string;
	class?: string;
	html?: boolean;
}

const { key, tag = 'span', class: className = '', html = false } = Astro.props;
---

<{tag} 
	data-i18n={key} 
	class={className}
	{...(html ? { 'data-i18n-html': '' } : {})}
/>
