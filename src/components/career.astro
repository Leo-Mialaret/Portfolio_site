---
import t from './t.astro';
import careerData from '../data/career.json';
import careerCards from '../data/career.json';
---

<section id="career" class="career">
	<div class="container">
		<t key="career.title" tag="h2" class="section-title" />
		<t key="career.subtitle" tag="p" class="section-subtitle" />
		
		<div class="career-content">
			<div class="timeline">
				<!-- Timeline items would go here -->
			</div>
		</div>
	</div>
</section>

<style>
	.career {
		padding: 6rem 2rem;
		background: var(--bg-secondary);
	}
	
	.container {
		max-width: 1000px;
		margin: 0 auto;
	}
	
	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		text-align: center;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}
	
	.section-subtitle {
		text-align: center;
		color: var(--text-secondary);
		font-size: 1.125rem;
		max-width: 600px;
		margin: 0 auto 3rem;
	}
</style>
