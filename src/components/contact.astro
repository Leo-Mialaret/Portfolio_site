---
import t from './t.astro';
---

<section id="contact" class="contact">
	<div class="container">
		<t key="contact.title" tag="h2" class="section-title" />
		<t key="contact.subtitle" tag="p" class="section-subtitle" />
		<t key="contact.description" tag="p" class="contact-description" />
		
		<div class="contact-content">
			<!-- Contact form and info would go here -->
		</div>
	</div>
</section>

<style>
	.contact {
		padding: 6rem 2rem;
	}
	
	.container {
		max-width: 800px;
		margin: 0 auto;
	}
	
	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		text-align: center;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}
	
	.section-subtitle {
		text-align: center;
		color: var(--text-secondary);
		font-size: 1.125rem;
		margin-bottom: 1rem;
	}
	
	.contact-description {
		text-align: center;
		color: var(--text-secondary);
		max-width: 600px;
		margin: 0 auto 3rem;
		line-height: 1.6;
	}
</style>
