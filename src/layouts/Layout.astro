---
interface Props {
	title: string;
	description?: string;
	image?: string;
	scripts?: string[];
}

const { title, description = "Portfolio de Léo Mialaret - Développeur Full Stack", image } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<script src="/i18n.js" defer></script>
	</head>
	<body>
		<slot />
	</body>
</html>
